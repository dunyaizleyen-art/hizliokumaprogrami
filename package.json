{
  "name": "odak-okuyucu",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Türkçe akademik metinler için tamamen yerel RSVP hızlı okuma aracı (Rapid Reader web fork'u)",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --open",
